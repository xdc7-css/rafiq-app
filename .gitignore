# ==============================================================================
# Rafeeq (رَفِيقْ) — Comprehensive .gitignore
# Professional Git Ignore Policy for Flutter / Android / iOS / Web / AI Tooling
# ==============================================================================

# ── 1. Operating System & System Metadata ──
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── 2. Miscellaneous & Temporary Files ──
*.class
*.log
*.pyc
*.swp
*.swo
*~
*.tmp
*.temp
*.orig
*.rej
*.bak
*.backup
.history
migrate_working_dir/

# ── 3. Crash Dumps & Debug Logs ──
hs_err_pid*.log
replay_pid*.log
flutter_*.log
flutter_*.txt
*.stackdump

# ── 4. IDE & Editor Artifacts ──
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.code-workspace
.atom/
.settings/
.project
.classpath

# ── 5. Flutter / Dart / Pub ──
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
build/
coverage/
**/doc/api/
*.symbols
app.*.symbols
app.*.map.json
*.dart.js
*.info.json

# ── 6. Android Platform & Gradle ──
android/.gradle/
android/.kotlin/
.kotlin/
android/app/build/
android/build/
android/.idea/
android/*.iml
android/local.properties
local.properties
android/captures/
.gradle/
**/android/app/debug
**/android/app/profile
**/android/app/release

# ── 7. iOS / macOS Ephemeral & CocoaPods ──
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
ios/Flutter/.last_build_id
ios/Flutter/ephemeral/
macos/Pods/
macos/.symlinks/
macos/Build/
macos/Flutter/ephemeral/
*.xcworkspace
*.xcuserdata

# ── 8. Linux / Windows Ephemeral ──
linux/build/
linux/flutter/ephemeral/
windows/build/
windows/flutter/ephemeral/

# ── 9. Firebase & Cloud Tools ──
.firebase/
.firebaserc.local
firebase-debug.log
firestore-debug.log
ui-debug.log

# ── 10. Node.js / Functions ──
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 11. Security, Keys & Secrets ──
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.p8
*.pem
*.der
*.key
*.crt
*.csr
*credentials*.json
*service-account*.json

# ── 12. Local Toolchain & Version Managers ──
.fvm/

# ── 13. AI Development Artifacts & Agent State ──
.agents/
.opencode/
.claude/
skills-lock.json
*.ai.log

# ── 14. Release Binaries (Attach to GitHub Releases) ──
*.apk
*.aab
*.zip
*.ipa

# ── 15. Scratch & Ad-hoc Testing Scripts ──
test_svg_*.dart
test_*.scratch.dart

# ── 16. Keep Source Assets and Required Config Tracked ──
!android/
!ios/
!lib/
!assets/
!web/
!linux/
!macos/
!windows/
!test/
!pubspec.yaml
!pubspec.lock
!firebase.json
!shorebird.yaml
!.env.example

