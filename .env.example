# ==============================================================================
# Rafeeq (رَفِيقْ) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or supply arguments via --dart-define during build/run.
# Example: flutter run --dart-define=RAPID_API_KEY=your_key_here
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# RapidAPI Key for ShiaAPI (Hadith books & search sync)
RAPID_API_KEY=

# Disable non-critical startup APIs during local dev (true | false)
DISABLE_NON_CRITICAL_APIS=false
